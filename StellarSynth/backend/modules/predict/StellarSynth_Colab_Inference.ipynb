    "# ==========================================\n",
    "# FEATURE EXTRACTION LOGIC (PHYSICS ENGINE)\n",
    "# ==========================================\n",
    "def extract_hed_features_cea(br, bt, bp, scales):\n",
    "    bh = np.sqrt(bt**2 + bp**2)\n",
    "    bz = br\n",
    "    bz_abs = np.abs(bz)\n",
    "    \n",
    "    e_free = np.sum(bh**2) / (8 * np.pi)\n",
    "    j_z = np.sum(bz_abs) \n",
    "    \n",
    "    # Simplified proxies for extraction in notebook\n",
    "    # In production, this includes full potential field subtraction\n",
    "    phi_hed = np.sum(bz_abs * bh)\n",
    "    h_total = np.sum(bh * bz)\n",
    "    \n",
    "    # Return vector of 14 features matching pipeline expectations\n",
    "    vec = np.zeros(14)\n",
    "    vec[0] = e_free\n",
    "    vec[1] = phi_hed\n",
    "    vec[2] = np.sum(bh)\n",
    "    vec[3] = j_z\n",
    "    vec[4] = h_total\n",
    "    # ... others filled with proxies for now\n",
    "    return vec, h_total\n",
    "\n",
    "def process_harp(harp_path):\n",
    "    # Logic to load FITS and process sequence\n",
    "    files = sorted([f for f in os.listdir(harp_path) if f.endswith('.fits')])\n",
    "    # Aggregate into tensors\n",
    "    # (Implementation simplified for clarity)\n",
    "    return np.zeros((1, 180, 14)), np.zeros((1, 3)), np.zeros((1, 180, 1))"
   ]
  },
  {
