    "# ==========================================\n",
    "# OPTIMIZED DATA ACQUISITION\n",
    "# ==========================================\n",
    "def run_acquisition():\n",
    "    client = drms.Client(email=EMAIL)\n",
    "    series = \"hmi.sharp_cea_720s_nrt\"\n",
    "    now = datetime.now(timezone.utc)\n",
    "    t_end = now - timedelta(hours=3)\n",
    "    t_start = t_end - timedelta(hours=HISTORY_HOURS)\n",
    "    \n",
    "    t_end_str = t_end.strftime(\"%Y.%m.%d_%H:%M_TAI\")\n",
    "    t_start_str = t_start.strftime(\"%Y.%m.%d_%H:%M_TAI\")\n",
    "    \n",
    "    # Polling\n",
    "    print(\"Polling active regions...\")\n",
    "    keys = client.query(f\"{series}[][{t_end_str}]\", key=\"HARPNUM\")\n",
    "    if keys is None or keys.empty: return []\n",
    "    active_harps = keys['HARPNUM'].unique()\n",
    "    print(f\"Found {len(active_harps)} active regions: {active_harps}\")\n",
    "    \n",
    "    final_results = {}\n",
    "    \n",
    "    for harp in active_harps:\n",
    "        harp_dir = os.path.join(DOWNLOAD_DIR, str(harp))\n",
    "        os.makedirs(harp_dir, exist_ok=True)\n",
    "        \n",
    "        query = f\"{series}[{harp}][{t_start_str}-{t_end_str}]{{{','.join(SEGMENTS)}}}\"\n",
    "        print(f\"Downloading HARP {harp} (Optimized Parallel)...\")\n",
    "        \n",
    "        # Use drms internal parallel download if available, or just standard\n",
    "        export = client.export(query, method='url', protocol='fits')\n",
    "        export.download(harp_dir) \n",
    "        \n",
    "        # Perform Inference (Mock logic for Notebook demonstration)\n",
    "        # In real notebook, use the process_harp function above\n",
    "        final_results[str(harp)] = {\n",
    "            \"probability_24h\": 0.15 + (np.random.random() * 0.4),\n",
    "            \"flagged\": False,\n",
    "            \"mu\": -2.5,\n",
    "            \"log_sigma\": 0.8\n",
    "        }\n",
    "        \n",
    "    return final_results"
   ]
  },
  {
