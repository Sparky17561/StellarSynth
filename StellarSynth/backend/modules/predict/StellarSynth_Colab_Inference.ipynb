    "# ==========================================\n",
    "# MODEL ARCHITECTURE (AthenaCTGRU)\n",
    "# ==========================================\n",
    "class AthenaCTGRU(nn.Module):\n",
    "    def __init__(self, input_dim=13, hidden_dim=128, static_dim=3, mlp_dim1=64, mlp_dim2=32, dropout=0.2):\n",
    "        super().__init__()\n",
    "        self.hidden_dim = hidden_dim\n",
    "        self.decay_w = nn.Linear(1, hidden_dim)\n",
    "        self.gru_cell = nn.GRUCell(input_dim, hidden_dim)\n",
    "        self.mlp = nn.Sequential(\n",
    "            nn.Linear(hidden_dim + static_dim, mlp_dim1),\n",
    "            nn.GELU(),\n",
    "            nn.Dropout(dropout),\n",
    "            nn.Linear(mlp_dim1, mlp_dim2),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(mlp_dim2, 2),\n",
    "        )\n",
    "\n",
    "    def forward(self, x_dyn, x_stat, x_mask):\n",
    "        B, T, _ = x_dyn.shape\n",
    "        dev = x_dyn.device\n",
    "        h = torch.zeros(B, self.hidden_dim, device=dev)\n",
    "        delta_t = torch.zeros(B, 1, device=dev)\n",
    "\n",
    "        for t in range(T):\n",
    "            x_t = x_dyn[:, t, :]\n",
    "            m_t = x_mask[:, t, :]\n",
    "            jolt_w = (m_t * x_mask[:, t - 1, :]).squeeze(-1) if t > 0 else m_t.squeeze(-1)\n",
    "            \n",
    "            scale = torch.ones(B, 13, device=dev)\n",
    "            scale[:, 11] = jolt_w\n",
    "            x_t = x_t * scale\n",
    "            \n",
    "            delta_t = delta_t + 0.2\n",
    "            gamma = torch.exp(-F.relu(self.decay_w(delta_t)))\n",
    "            h_decayed = h * gamma\n",
    "            h_new = self.gru_cell(x_t, h_decayed)\n",
    "            h = m_t * h_new + (1.0 - m_t) * h_decayed\n",
    "            delta_t = delta_t * (1.0 - m_t)\n",
    "\n",
    "        z = torch.cat([h, x_stat], dim=-1)\n",
    "        return self.mlp(z)"
   ]
  },
  {
